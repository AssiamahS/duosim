# Copy to .env and run:  node --env-file=.env server.js
# Every value is optional; see "Configuration" in README.md for the full list.

# A fixed token keeps the URL working across restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
TOKEN=

# Which simulator to attach to. Required once more than one is booted:
#   xcrun simctl list devices booted
UDID=

# What to call this instance in the tab title, the page header and the logs.
# Defaults to the simulator's own name.
LABEL=

PORT=8787

# iPhone Duo: capture a chosen panel, and route taps to a chosen panel.
# Leave both unset for a normal, single-screen simulator.
# CAPTURE=simctl
# INPUT=duo
